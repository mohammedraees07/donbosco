---
// src/components/Gallery.astro
const photos = [
  { src: "/gallery/1.jpg", alt: "School Event 1" },
  { src: "/gallery/2.jpg", alt: "School Event 2" },
  { src: "/gallery/3.jpg", alt: "School Event 3" }
];

const videos = [
  { src: "/gallery/5.jpg", alt: "School Video 1", videoId: "YE7VzlLtp-4" },
  { src: "/gallery/6.jpg", alt: "School Video 2", videoId: "YE7VzlLtp-4" },
  { src: "/gallery/1.jpg", alt: "School Video 3", videoId: "YE7VzlLtp-4" }
];
---
<section id="gallery" class="gallery-section section-padding">
  <div class="container">
    <div class="gallery-stack">
      
      <!-- Photo Gallery -->
      <div class="gallery-section-block">
        <div class="section-header text-center">
          <span class="section-subtitle">Moments To Cherish</span>
          <h2 class="section-title">Photo Gallery</h2>
        </div>
        
        <div class="gallery-grid">
          {photos.map((image) => (
            <div class="gallery-item">
              <img src={image.src} alt={image.alt} class="gallery-img" loading="lazy" />
              <div class="gallery-overlay">
                <svg viewBox="0 0 24 24" width="32" height="32" stroke="var(--primary-color)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
              </div>
            </div>
          ))}
        </div>
        
        <div class="mt-40 text-center">
          <a href="/photo-gallery" class="btn btn-outline">View Photo Gallery</a>
        </div>
      </div>

      <!-- Video Gallery -->
      <div class="gallery-section-block">
        <div class="section-header text-center">
          <span class="section-subtitle">Watch Us In Action</span>
          <h2 class="section-title">Video Gallery</h2>
        </div>
        
        <div class="gallery-grid">
          {videos.map((video) => (
            <div class="gallery-item video-item" data-video-id={video.videoId}>
              <img src={video.src} alt={video.alt} class="gallery-img" loading="lazy" />
              <div class="gallery-overlay video-overlay">
                <div class="play-btn">
                  <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="currentColor" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                </div>
              </div>
            </div>
          ))}
        </div>
        
        <div class="mt-40 text-center">
          <a href="/video-gallery" class="btn btn-outline">View Video Gallery</a>
        </div>
      </div>

    </div>
  </div>
  
  <!-- Video Modal -->
  <dialog id="video-modal" class="video-modal">
    <div class="video-modal-content">
      <button id="close-video-modal" class="close-modal" aria-label="Close video">&times;</button>
      <div class="video-container" id="video-container"></div>
    </div>
  </dialog>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const videoItems = document.querySelectorAll('.video-item');
    const modal = document.getElementById('video-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('close-video-modal');
    const videoContainer = document.getElementById('video-container');

    if (!modal || !videoContainer) return;

    videoItems.forEach(item => {
      item.addEventListener('click', () => {
        const videoId = item.getAttribute('data-video-id');
        if (videoId) {
          // Use inline styles to ensure the iframe fills the container despite Astro CSS scoping
          videoContainer.innerHTML = `<iframe src="https://www.youtube.com/embed/${videoId}?autoplay=1" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;" allow="autoplay; encrypted-media" allowfullscreen></iframe>`;
          modal.showModal();
          document.body.style.overflow = 'hidden'; // Prevent scrolling
        }
      });
    });

    const closeModal = () => {
      modal.close();
      videoContainer.innerHTML = ''; // Stop video from playing in background
      document.body.style.overflow = '';
    };

    closeBtn?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      // Close when clicking the backdrop
      const rect = modal.getBoundingClientRect();
      if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) {
        closeModal();
      }
    });
    
    // Close on escape key is natively handled by <dialog>, but we need to stop the video
    modal.addEventListener('close', () => {
      videoContainer.innerHTML = '';
      document.body.style.overflow = '';
    });
  });
</script>

<style>
  .gallery-section {
    background-color: var(--bg-color);
  }
  
  .gallery-stack {
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  .section-header {
    margin-bottom: 40px;
  }
  
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  
  .gallery-item {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4/3;
    cursor: pointer;
  }
  
  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }
  
  .gallery-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(17, 17, 17, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-normal);
  }
  
  .video-overlay {
    opacity: 1; /* Always show play button slightly */
    background-color: rgba(17, 17, 17, 0.3);
  }
  
  .play-btn {
    width: 60px;
    height: 60px;
    background-color: var(--primary-color);
    color: var(--bg-dark);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-normal);
  }
  
  .play-btn svg {
    margin-left: 4px; /* visually center the triangle */
    width: 28px;
    height: 28px;
  }

  .gallery-item:hover .gallery-img {
    transform: scale(1.1);
  }
  
  .gallery-item:hover .gallery-overlay {
    opacity: 1;
  }
  
  .video-item:hover .play-btn {
    transform: scale(1.15);
  }
  
  .gallery-overlay svg:not(.play-btn svg) {
    transform: scale(0.5);
    transition: transform var(--transition-normal);
  }
  
  .gallery-item:hover .gallery-overlay svg:not(.play-btn svg) {
    transform: scale(1);
  }
  
  .mt-40 {
    margin-top: 40px;
  }
  
  /* Video Modal Styles */
  .video-modal {
    border: none;
    background: transparent;
    padding: 0;
    max-width: 900px;
    width: 90%;
    margin: auto;
    overflow: visible;
  }
  
  .video-modal::backdrop {
    background-color: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(5px);
  }
  
  .video-modal-content {
    position: relative;
    width: 100%;
    background: #000;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }
  
  .video-container {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    height: 0;
    overflow: hidden;
    border-radius: 8px;
    width: 100%;
  }
  
  .close-modal {
    position: absolute;
    top: -40px;
    right: 0;
    background: transparent;
    border: none;
    color: white;
    font-size: 36px;
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s;
  }
  
  .close-modal:hover {
    color: var(--primary-color);
  }
  
  @media (max-width: 992px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }
  
  @media (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }
  }
</style>
