---
// src/components/News.astro
const news = [
  {
    title: "Patron's Day Celebration",
    date: "February 28, 2026",
    category: "2025-2026",
    image: "https://donboscoschoolshirva.com/wp-content/uploads/2026/02/MG_1325-scaled-500x352.jpg",
    excerpt: "Don Bosco School celebrated its Patron’s Day with great joy and devotion on the feast day of St. John Bosco."
  },
  {
    title: "Farewell Ceremony of Grade 10",
    date: "February 22, 2026",
    category: "2025-2026",
    image: "https://donboscoschoolshirva.com/wp-content/uploads/2026/02/MG_0902-scaled-500x352.jpg",
    excerpt: "The Farewell Ceremony for the Grade 10 students of the 2025–26 batch was held on 28th January 2026."
  },
  {
    title: "Republic Day Celebration",
    date: "January 26, 2026",
    category: "2025-2026",
    image: "/events/event3.png",
    excerpt: "The 76th Republic Day was celebrated with patriotic fervor in the school premises."
  },
  {
    title: "Christmas Celebration",
    date: "December 23, 2025",
    category: "2025-2026",
    image: "/events/event4.png",
    excerpt: "The joyous festival of Christmas was celebrated with a special assembly and cultural programs."
  }
];
---
<section id="news" class="news-section section-padding">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-subtitle">Stay Updated</span>
      <h2 class="section-title">News & Events</h2>
    </div>
    
    <div class="news-carousel-wrapper">
      <div class="news-carousel" id="news-carousel">
        {news.map((item) => (
          <div class="news-slide">
            <article class="news-card">
              <div class="news-img-wrapper">
                <img src={item.image} alt={item.title} class="news-img" loading="lazy" />
                <span class="news-category">{item.category}</span>
              </div>
              <div class="news-content">
                <div class="news-meta">
                  <span class="news-date">
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="css-i6dzq1"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    {item.date}
                  </span>
                </div>
                <h3 class="news-title"><a href="#">{item.title}</a></h3>
                <p class="news-excerpt">{item.excerpt}</p>
                <a href="#" class="news-read-more">Read More <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
              </div>
            </article>
          </div>
        ))}
      </div>
      
      <div class="carousel-controls">
        <button class="carousel-btn prev" id="news-prev" aria-label="Previous news">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button class="carousel-btn next" id="news-next" aria-label="Next news">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousel = document.getElementById('news-carousel');
    const prevBtn = document.getElementById('news-prev');
    const nextBtn = document.getElementById('news-next');
    
    if (carousel && prevBtn && nextBtn) {
      const getScrollAmount = () => {
        const slide = carousel.querySelector('.news-slide') as HTMLElement | null;
        return slide ? slide.offsetWidth + 30 : 0;
      };
      
      nextBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
      });
      
      prevBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
      });
    }
  });
</script>

<style>
  .news-section {
    background-color: var(--bg-light);
  }
  
  .section-header {
    margin-bottom: 50px;
  }
  
  /* Carousel Layout */
  .news-carousel-wrapper {
    position: relative;
    padding: 0 40px;
  }
  
  .news-carousel {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 20px;
  }
  
  .news-carousel::-webkit-scrollbar {
    display: none;
  }
  
  .news-slide {
    flex: 0 0 calc(33.333% - 20px);
    scroll-snap-align: start;
    min-width: 0;
  }
  
  /* Original Card Styling restored below */
  .news-card {
    background: var(--bg-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  
  .news-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-xl);
  }
  
  .news-img-wrapper {
    position: relative;
    height: 280px;
    overflow: hidden;
  }
  
  .news-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }
  
  .news-card:hover .news-img {
    transform: scale(1.05);
  }
  
  .news-category {
    position: absolute;
    top: 20px;
    right: 20px;
    background-color: var(--primary-color);
    color: var(--bg-dark);
    padding: 5px 15px;
    border-radius: 30px;
    font-size: 0.8rem;
    font-weight: 600;
    z-index: 2;
  }
  
  .news-content {
    padding: 30px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  
  .news-meta {
    margin-bottom: 10px;
  }
  
  .news-date {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
  }
  
  .news-title {
    font-size: 1.5rem;
    margin-bottom: 15px;
  }
  
  .news-title a {
    color: var(--bg-dark);
    transition: color var(--transition-fast);
  }
  
  .news-title a:hover {
    color: var(--primary-color);
  }
  
  .news-excerpt {
    color: var(--text-muted);
    margin-bottom: 20px;
    line-height: 1.6;
    flex-grow: 1;
  }
  
  .news-read-more {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--primary-color);
    font-weight: 600;
    transition: gap var(--transition-fast);
  }
  
  .news-read-more:hover {
    gap: 10px;
  }

  /* Carousel Navigation Buttons */
  .carousel-controls {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }
  
  .carousel-btn {
    pointer-events: auto;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid rgba(0,0,0,0.1);
    color: var(--text-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    transition: all var(--transition-fast);
    z-index: 10;
  }
  
  .carousel-btn:hover {
    background-color: var(--primary-color);
    color: var(--bg-dark);
    border-color: var(--primary-color);
    transform: scale(1.1);
  }
  
  .carousel-btn.prev { transform: translateX(-50%); }
  .carousel-btn.next { transform: translateX(50%); }
  .carousel-btn.prev:hover { transform: translateX(-50%) scale(1.1); }
  .carousel-btn.next:hover { transform: translateX(50%) scale(1.1); }

  @media (max-width: 992px) {
    .carousel-controls { display: flex; }
    .carousel-btn {
      width: 40px;
      height: 40px;
    }
    .carousel-btn.prev { transform: translateX(-10px); }
    .carousel-btn.next { transform: translateX(10px); }
    .carousel-btn.prev:hover { transform: translateX(-10px) scale(1.1); }
    .carousel-btn.next:hover { transform: translateX(10px) scale(1.1); }
    .news-carousel { gap: 20px; }
    .news-slide { flex: 0 0 calc(50% - 10px); }
  }
  
  @media (max-width: 768px) {
    .news-slide { flex: 0 0 100%; }
    .news-img-wrapper { height: 200px; }
    .news-content { padding: 20px; }
    .news-title { font-size: 1.25rem; margin-bottom: 10px; }
    .news-excerpt { font-size: 0.95rem; margin-bottom: 15px; }
  }
</style>
