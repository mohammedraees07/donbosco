---
// src/components/Footer.astro
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand-contact">
        <a href="/" class="footer-logo">
          <img src="/logo.jpg" alt="Don Bosco School Logo" class="footer-logo-img" />
          <div class="logo-text">
            <span class="school-name">Don Bosco</span>
            <span class="school-subtitle">English Medium School Shirva</span>
          </div>
        </a>
        
        <h4 class="footer-heading" style="margin-top: 30px; margin-bottom: 15px;">Contact Us</h4>
        <ul class="contact-list">
          <li>
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <span>+91 87220 89715</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <span>shirvadonboscoschool@gmail.com</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>Shirva, Udupi District<br/>Pincode – 574116</span>
          </li>
        </ul>
      </div>
      
      <div class="footer-links-container">
        <div class="footer-links">
          <h4 class="footer-heading">About Us</h4>
          <ul>
            <li><a href="#">Know your Don Bosco</a></li>
            <li><a href="#">School Anthem</a></li>
            <li><a href="#">History</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </div>
        
        <div class="footer-links">
          <h4 class="footer-heading">Information</h4>
          <ul>
            <li><a href="#">Mandatory Disclosures</a></li>
            <li><a href="#">CBSE Requirements</a></li>
            <li><a href="#facilities">Facilities</a></li>
            <li><a href="#admissions">Admission</a></li>
          </ul>
        </div>
        
        <div class="footer-links">
          <h4 class="footer-heading">Academics</h4>
          <ul>
            <li><a href="#">Academics</a></li>
            <li><a href="#">Annual report</a></li>
            <li><a href="#">Achievements</a></li>
            <li><a href="#">Board Results</a></li>
          </ul>
        </div>
        
        <div class="footer-links">
          <h4 class="footer-heading">Media</h4>
          <ul>
            <li><a href="#events">Events</a></li>
            <li><a href="#">Photo Gallery</a></li>
            <li><a href="#">Video Gallery</a></li>
            <li><a href="#">School Magazine</a></li>
          </ul>
        </div>
      </div>
    </div>
    
    <div class="footer-bottom">
      <div class="copyright-info">
        <p>Copyright &copy; {new Date().getFullYear()}. All Rights Reserved by Don Bosco Shirva.</p>
      </div>
      <div class="social-links">
        <a href="https://www.facebook.com/donboscocbseshirva" class="social-link" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
        <a href="https://x.com/DonBoscoSchoolShirva" class="social-link" aria-label="Twitter">
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
        </a>
        <a href="https://www.instagram.com/donboscoshoolshirva/" class="social-link" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-dark);
    color: var(--text-light);
    padding: 80px 0 30px;
    margin-top: 60px;
  }
  
  .footer-top {
    display: flex;
    flex-direction: row;
    gap: 40px;
    margin-bottom: 60px;
  }
  
  .footer-brand-contact {
    flex: 0 0 320px;
  }
  
  .footer-links-container {
    flex: 1;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 30px;
    min-width: 0;
  }
  
  .footer-links {
    flex: 1;
    min-width: 150px;
  }
  
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 25px;
  }
  
  .footer-logo-img {
    height: 50px;
    width: auto;
    border-radius: 50%;
    background-color: #fff;
    padding: 2px;
  }
  
  .logo-text {
    display: flex;
    flex-direction: column;
  }
  
  .school-name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.2rem;
    color: var(--primary-color);
    line-height: 1.1;
  }
  
  .school-subtitle {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .footer-heading {
    color: var(--primary-color);
    font-size: 1.1rem;
    margin-bottom: 20px;
    font-family: var(--font-heading);
  }
  
  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  
  .contact-list li {
    display: flex;
    gap: 15px;
    color: rgba(255, 255, 255, 0.8);
    align-items: flex-start;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  
  .contact-list svg {
    color: var(--primary-color);
    flex-shrink: 0;
    margin-top: 2px;
  }
  
  .footer-links ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  
  .footer-links a {
    color: rgba(255, 255, 255, 0.7);
    transition: color var(--transition-fast);
    font-size: 0.95rem;
  }
  
  .footer-links a:hover {
    color: var(--primary-color);
    padding-left: 5px;
  }
  
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
  }
  
  .copyright-info {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  
  .designer {
    font-size: 0.8rem;
    opacity: 0.7;
  }
  
  .social-links {
    display: flex;
    gap: 15px;
  }
  
  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--text-light);
    border-radius: 50%;
    transition: all var(--transition-fast);
  }
  
  .social-link:hover {
    background-color: var(--primary-color);
    color: var(--bg-dark);
    transform: translateY(-3px);
  }
  
  @media (max-width: 1024px) {
    .footer-links-container {
      justify-content: flex-start;
      gap: 40px;
    }
    .footer-links {
      flex: 0 0 calc(50% - 20px);
    }
  }
  
  @media (max-width: 768px) {
    .footer-top {
      flex-direction: column;
      gap: 40px;
    }
    
    .footer-brand-contact {
      flex: auto;
    }

    .footer-links {
      flex: 0 0 100%;
    }
    
    .footer-bottom {
      flex-direction: column;
      text-align: center;
      gap: 20px;
    }
    
    .copyright-info {
      align-items: center;
    }
    
    .social-links {
      justify-content: center;
    }
  }
</style>
