---
// src/components/Testimonials.astro
const testimonials = [
  {
    name: "Mohammed Fauzan",
    role: "Alumnus",
    image: "/testimonials/t1.jpg",
    quote: "I am proud to be an alumnus of Don Bosco English Medium School, Shirva. Reflecting on my journey, I am filled with gratitude for the foundational years I spent within those vibrant walls. Focus on developing practical skills and embracing opportunities."
  },
  {
    name: "Ancha Oshin Dsouza",
    role: "Chartered Accountant & Public Speaker",
    image: "/testimonials/t2.jpg",
    quote: "My journey to becoming a Chartered Accountant, poet, and public speaker was firmly rooted in the strong foundation laid during my primary and high school years at Don Bosco. The excellent teaching and unwavering support were instrumental in my successes."
  },
  {
    name: "Dr. Edlin Glane Mathias",
    role: "Ph.D.",
    image: "/testimonials/t3.jpg",
    quote: "My time there provided a strong academic foundation and taught me important life lessons in discipline, responsibility, and integrity. The dedicated teachers instilled in me a love for learning, which has guided me throughout my career."
  },
  {
    name: "Sarah Dsouza",
    role: "Alumnus",
    image: "/testimonials/t4.jpg",
    quote: "When I first entered Don Bosco School, I was shy and struggling with English, but the school gave me a voice, a stage, and the courage to dream big. Today, I am a lecturer in nursing at the University of Worcester, UK, thanks to the transformative education."
  },
  {
    name: "Shreya Achar",
    role: "Alumnus",
    image: "/testimonials/t5.jpg",
    quote: "As a proud alumna of Don Bosco School, I attribute my academic excellence and discovery of my passion for dance to the nurturing environment provided by the school. The unwavering support from teachers has been invaluable."
  },
  {
    name: "Xanely Dsouza",
    role: "Alumnus",
    image: "/testimonials/t6.jpg",
    quote: "The Knowledge, skills and connections I gained in academics or extracurricular activities during my time here have been invaluable in shaping who I am today. All my teachers were incredibly supportive."
  },
  {
    name: "Roline Stapny Saldanha",
    role: "Software Development Engineer, Amazon Seattle",
    image: "/testimonials/t7.jpg",
    quote: "Attending Don Bosco from pre-school to 10th standard was a transformative experience for me, shaping my personal growth and instilling strong moral values. Don Bosco gifted me with invaluable confidence in my abilities."
  }
];
---
<section class="testimonials-section section-padding">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-subtitle">What They Say</span>
      <h2 class="section-title text-white">Student Testimonials</h2>
    </div>
    
    <div class="testimonials-carousel-wrapper">
      <div class="testimonials-carousel" id="testimonials-carousel">
        {testimonials.map((testimonial) => (
          <div class="testimonial-slide">
            <div class="testimonial-card glass-card">
              <div class="quote-icon">
                <svg viewBox="0 0 24 24" width="40" height="40" fill="var(--primary-color)"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
              </div>
              <p class="testimonial-quote">"{testimonial.quote}"</p>
              <div class="testimonial-author">
                <div class={`author-avatar ${testimonial.image ? 'has-image' : ''}`}>
                  {testimonial.image ? (
                    <img src={testimonial.image} alt={testimonial.name} loading="lazy" />
                  ) : (
                    testimonial.name.charAt(0)
                  )}
                </div>
                <div class="author-info">
                  <h4 class="author-name">{testimonial.name}</h4>
                  <span class="author-role">{testimonial.role}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      
      <div class="carousel-controls testimonials-controls">
        <button class="carousel-btn prev" id="testimonials-prev" aria-label="Previous testimonial">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button class="carousel-btn next" id="testimonials-next" aria-label="Next testimonial">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousel = document.getElementById('testimonials-carousel');
    const prevBtn = document.getElementById('testimonials-prev');
    const nextBtn = document.getElementById('testimonials-next');
    
    if (carousel && prevBtn && nextBtn) {
      const getScrollAmount = () => {
        const slide = carousel.querySelector('.testimonial-slide') as HTMLElement | null;
        return slide ? slide.offsetWidth + 30 : 0;
      };
      
      nextBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
      });
      
      prevBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
      });
    }
  });
</script>

<style>
  .testimonials-section {
    background-color: var(--bg-dark);
    color: var(--text-light);
    position: relative;
  }
  
  /* Decorative background */
  .testimonials-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: linear-gradient(rgba(17, 17, 17, 0.9), rgba(17, 17, 17, 0.9)), url('/hero_background.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    z-index: 0;
  }
  
  .container {
    position: relative;
    z-index: 1;
  }
  
  .text-white {
    color: #ffffff;
  }
  
  .section-header {
    margin-bottom: 60px;
  }
  
  /* Carousel Layout */
  .testimonials-carousel-wrapper {
    position: relative;
    padding: 0 40px;
  }
  
  .testimonials-carousel {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 20px;
  }
  
  .testimonials-carousel::-webkit-scrollbar {
    display: none;
  }
  
  .testimonial-slide {
    flex: 0 0 calc(33.333% - 20px);
    scroll-snap-align: start;
    min-width: 0;
  }
  
  .testimonial-card {
    padding: 40px 30px;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: transform var(--transition-normal);
  }
  
  .testimonial-card:hover {
    transform: translateY(-5px);
  }
  
  .quote-icon {
    margin-bottom: 20px;
    opacity: 0.5;
  }
  
  .testimonial-quote {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.05rem;
    line-height: 1.7;
    flex-grow: 1;
    font-style: italic;
    margin-bottom: 30px;
  }
  
  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 15px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 20px;
  }
  
  .author-avatar {
    width: 50px;
    height: 50px;
    min-width: 50px;
    background-color: var(--primary-color);
    color: var(--bg-dark);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    overflow: hidden;
  }
  
  .author-avatar.has-image {
    background-color: transparent;
  }
  
  .author-avatar img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    border-radius: 50%;
  }
  
  .author-info {
    display: flex;
    flex-direction: column;
  }
  
  .author-name {
    font-family: var(--font-heading);
    color: #ffffff;
    font-size: 1.1rem;
    margin-bottom: 3px;
  }
  
  .author-role {
    color: var(--primary-color);
    font-size: 0.85rem;
    font-weight: 500;
  }
  
  /* Carousel Navigation Buttons */
  .carousel-controls {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    pointer-events: none;
    /* Force HMR to ensure Vite detects new images in public directory */
  }
  
  .carousel-btn {
    pointer-events: auto;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid rgba(0,0,0,0.1);
    color: #111111;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    transition: all var(--transition-fast);
    z-index: 10;
  }
  
  .carousel-btn:hover {
    background-color: var(--primary-color);
    color: var(--bg-dark);
    border-color: var(--primary-color);
    transform: scale(1.1);
  }
  
  .carousel-btn.prev { transform: translateX(-50%); }
  .carousel-btn.next { transform: translateX(50%); }
  .carousel-btn.prev:hover { transform: translateX(-50%) scale(1.1); }
  .carousel-btn.next:hover { transform: translateX(50%) scale(1.1); }

  @media (max-width: 992px) {
    .carousel-controls { display: flex; }
    .carousel-btn {
      width: 40px;
      height: 40px;
    }
    .carousel-btn.prev { transform: translateX(-10px); }
    .carousel-btn.next { transform: translateX(10px); }
    .carousel-btn.prev:hover { transform: translateX(-10px) scale(1.1); }
    .carousel-btn.next:hover { transform: translateX(10px) scale(1.1); }
    .testimonials-carousel { gap: 20px; }
    .testimonial-slide { flex: 0 0 calc(50% - 10px); }
  }
  
  @media (max-width: 768px) {
    .testimonial-slide { flex: 0 0 100%; }
    .testimonial-card { padding: 30px 20px; }
    .testimonial-quote { font-size: 0.95rem; margin-bottom: 20px; line-height: 1.5; }
    .quote-icon { margin-bottom: 15px; }
    .quote-icon svg { width: 30px; height: 30px; }
  }
</style>
