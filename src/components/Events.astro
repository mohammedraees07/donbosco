---
// src/components/Events.astro
const events = [
  {
    title: "Annual Day - Secondary Section",
    date: "28",
    month: "Nov",
    time: "3:00 PM",
    image: "/events/event1.png",
    excerpt: "The Annual Day of Secondary Section will be held on Friday, 28 November 2025."
  },
  {
    title: "Annual Day - Primary Section",
    date: "27",
    month: "Nov",
    time: "3:00 PM",
    image: "/events/event2.png",
    excerpt: "The Annual Day of Primary Section will be held on Thursday, 27 November 2025."
  },
  {
    title: "Annual Day - Kindergarten Section",
    date: "26",
    month: "Nov",
    time: "9:30 AM",
    image: "/events/event3.png",
    excerpt: "The Annual Day of Kindergarten Section will be held on Wednesday, 26 November 2025."
  },
  {
    title: "Prize Distribution Day",
    date: "25",
    month: "Nov",
    time: "9:15 AM",
    image: "/events/event4.png",
    excerpt: "As a part of Annual Day Celebrations, the Prize Distribution Day will mark the hoisting of the School Flag."
  }
];
---
<section class="events-section section-padding">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-subtitle">Don't Miss Out</span>
      <h2 class="section-title">Upcoming Events</h2>
    </div>
    
    <div class="events-carousel-wrapper">
      <div class="events-carousel" id="events-carousel">
        {events.map((event) => (
          <div class="event-slide">
            <div class="event-card">
              <div class="event-image">
                <img src={event.image} alt={event.title} loading="lazy" />
                <div class="event-date">
                  <span class="date">{event.date}</span>
                  <span class="month">{event.month}</span>
                </div>
              </div>
              <div class="event-content">
                <h3 class="event-title"><a href="#">{event.title}</a></h3>
                <div class="event-meta">
                  <span class="meta-item">
                    <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    {event.time}
                  </span>
                </div>
                <p class="event-excerpt">{event.excerpt}</p>
                <a href="#" class="read-more">
                  Read More
                  <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
      
      <div class="carousel-controls">
        <button class="carousel-btn prev" id="carousel-prev" aria-label="Previous event">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button class="carousel-btn next" id="carousel-next" aria-label="Next event">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  // Simple vanilla JS carousel logic
  document.addEventListener('DOMContentLoaded', () => {
    const carousel = document.getElementById('events-carousel');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    
    if (carousel && prevBtn && nextBtn) {
      // Get the width of one slide + gap
      const getScrollAmount = () => {
        const slide = carousel.querySelector('.event-slide') as HTMLElement | null;
        return slide ? slide.offsetWidth + 30 : 0; // 30px is the gap
      };
      
      nextBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
      });
      
      prevBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
      });
    }
  });
</script>

<style>
  .events-section {
    background-color: var(--bg-color);
  }
  
  .section-header {
    margin-bottom: 50px;
  }
  
  .events-carousel-wrapper {
    position: relative;
    padding: 0 40px;
  }
  
  .events-carousel {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
    padding-bottom: 20px; /* Space for box shadow */
  }
  
  .events-carousel::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }
  
  .event-slide {
    flex: 0 0 calc(33.333% - 20px); /* 3 items visible by default */
    scroll-snap-align: start;
    min-width: 0;
  }
  
  .event-card {
    background-color: #ffffff;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-normal), transform var(--transition-normal);
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  
  .event-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-5px);
  }
  
  .event-image {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
  }
  
  .event-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }
  
  .event-card:hover .event-image img {
    transform: scale(1.05);
  }
  
  .event-date {
    position: absolute;
    top: 20px;
    left: 20px;
    background-color: var(--primary-color);
    color: var(--bg-dark);
    padding: 10px 15px;
    border-radius: var(--radius-md);
    text-align: center;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    min-width: 70px;
  }
  
  .event-date .date {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
  }
  
  .event-date .month {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    margin-top: 2px;
  }
  
  .event-content {
    padding: 30px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  
  .event-title {
    font-size: 1.25rem;
    margin-bottom: 15px;
    line-height: 1.4;
  }
  
  .event-title a {
    color: var(--text-dark);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  
  .event-title a:hover {
    color: var(--primary-color);
  }
  
  .event-meta {
    display: flex;
    gap: 15px;
    margin-bottom: 15px;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  
  .meta-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .meta-item svg {
    color: var(--primary-color);
  }
  
  .event-excerpt {
    color: var(--text-muted);
    margin-bottom: 25px;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-dark);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition-fast);
    align-self: flex-start;
  }
  
  .read-more:hover {
    color: var(--primary-color);
  }
  
  .read-more svg {
    transition: transform var(--transition-fast);
  }
  
  .read-more:hover svg {
    transform: translateX(5px);
  }
  
  .carousel-controls {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    pointer-events: none; /* Let clicks pass through empty space */
  }
  
  .carousel-btn {
    pointer-events: auto; /* Re-enable clicks for buttons */
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid rgba(0,0,0,0.1);
    color: var(--text-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    transition: all var(--transition-fast);
    z-index: 10;
  }
  
  .carousel-btn:hover {
    background-color: var(--primary-color);
    color: var(--bg-dark);
    border-color: var(--primary-color);
    transform: scale(1.1);
  }
  
  .carousel-btn.prev {
    transform: translateX(-50%);
  }
  
  .carousel-btn.next {
    transform: translateX(50%);
  }
  
  .carousel-btn.prev:hover {
    transform: translateX(-50%) scale(1.1);
  }
  
  .carousel-btn.next:hover {
    transform: translateX(50%) scale(1.1);
  }
  
  @media (max-width: 992px) {
    .carousel-controls {
      display: flex;
    }
    
    .carousel-btn {
      width: 40px;
      height: 40px;
    }
    
    .carousel-btn.prev {
      transform: translateX(-10px);
    }
    
    .carousel-btn.next {
      transform: translateX(10px);
    }
    
    .carousel-btn.prev:hover {
      transform: translateX(-10px) scale(1.1);
    }
    
    .carousel-btn.next:hover {
      transform: translateX(10px) scale(1.1);
    }
    
    .events-carousel {
      gap: 20px;
    }
    
    .event-slide {
      flex: 0 0 100%; 
    }
  }
  
  @media (max-width: 576px) {
    .event-slide {
      flex: 0 0 100%;
    }
    
    .event-content {
      padding: 20px;
    }
  }
</style>
